# ---------------------------------------------------------------------------
# CivicAI configuration. Copy this file to .env and adjust values.
# No real secrets are required for the local demo.
# ---------------------------------------------------------------------------

# Flask session signing key. Replace with a long random string for any shared
# or public deployment.
SECRET_KEY=change-this-demo-secret

# SQLite by default (instance/civicai.db). A full SQLAlchemy URL can be used.
# DATABASE_URL=sqlite:///instance/civicai.db

# Demo officer account. Change both before exposing the app.
OFFICER_USERNAME=officer
OFFICER_PASSWORD=civic2026

# Load the synthetic dataset automatically when the database is empty.
SEED_ON_START=1

# CSRF protection for browser form posts (keep enabled outside tests).
CSRF_ENABLED=1

# ---------------------------------------------------------------------------
# Optional OpenAI-compatible LLM. Leave blank to use the transparent local
# rule-based NLP engine. The key is read server-side and never sent to the
# browser.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=12
